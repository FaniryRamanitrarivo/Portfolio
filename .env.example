# Copy this file to `.env` and fill in real values.
# All variables are validated in src/lib/env.ts.

# --- Required -------------------------------------------------------------

# Postgres connection string. Matches docker-compose.yml for local dev;
# use your Neon URL in production.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_dev"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Optional: OAuth providers (only needed for the ones you use) ---------

GITHUB_ID=""
GITHUB_SECRET=""

GOOGLE_ID=""
GOOGLE_SECRET=""

# --- Optional: contact form (Resend) --------------------------------------

RESEND_API_KEY=""
CONTACT_EMAIL=""

# --- Optional: "book a call" CTA (Calendly / Cal.com link) ----------------
# The CTA is hidden if left empty.
BOOKING_URL=""

# --- Optional: canonical production URL (SEO: sitemap, robots, OG) --------
# Must be set in production.
SITE_URL="http://localhost:3000"

# --- Local dev only -------------------------------------------------------
# Bypasses NextAuth entirely. Never set to "true" outside local dev.
AUTH_DISABLED="false"
